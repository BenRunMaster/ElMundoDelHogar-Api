HOST=0.0.0.0
PORT=1337

# Generá secretos distintos para cada entorno antes de iniciar Strapi.
APP_KEYS=replace-me-key-1,replace-me-key-2
API_TOKEN_SALT=replace-me-api-token-salt
ADMIN_JWT_SECRET=replace-me-admin-jwt-secret
JWT_SECRET=replace-me-jwt-secret
TRANSFER_TOKEN_SALT=replace-me-transfer-token-salt
ENCRYPTION_KEY=replace-me-encryption-key

# Swagger UI: activo localmente; en producción se desactiva por defecto.
API_DOCS_ENABLED=true

# URL del formulario de Next.js que recibe el enlace de recuperación.
# Configurá la URL real cuando exista el frontend.
PANEL_RESET_PASSWORD_URL=http://localhost:3000/reset-password
# En producción debe ser true (usa HTTPS); en desarrollo local, false.
PANEL_AUTH_COOKIE_SECURE=false

# PostgreSQL, igual que la configuración existente del repositorio.
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=replace-me-database-password
DATABASE_SSL=false
DATABASE_SCHEMA=public
