{
  "kind": "collectionType",
  "collectionName": "categorias",
  "info": {
    "singularName": "categoria",
    "pluralName": "categorias",
    "displayName": "Categoría",
    "description": "Categorías del catálogo"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "nombre": { "type": "string", "required": true, "minLength": 2 },
    "descripcion": { "type": "text" },
    "icono": { "type": "string" },
    "iconoImagen": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "activo": { "type": "boolean", "default": true },
    "productos": { "type": "relation", "relation": "oneToMany", "target": "api::producto.producto", "mappedBy": "categoria" }
  }
}
