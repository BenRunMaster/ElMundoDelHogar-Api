{
  "kind": "collectionType",
  "collectionName": "sucursales",
  "info": {
    "singularName": "sucursal",
    "pluralName": "sucursales",
    "displayName": "Sucursal",
    "description": "Ubicaciones y horarios de las tiendas"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "nombre": { "type": "string", "required": true, "minLength": 2, "maxLength": 160 },
    "ciudad": { "type": "string", "required": true, "minLength": 2, "maxLength": 120 },
    "telefono": { "type": "string", "required": true, "maxLength": 40 },
    "direccion": { "type": "text", "required": true },
    "diasAtencion": { "type": "string", "required": true, "maxLength": 120 },
    "horaApertura": { "type": "time", "required": true },
    "horaCierre": { "type": "time", "required": true },
    "latitud": { "type": "decimal", "min": -90, "max": 90 },
    "longitud": { "type": "decimal", "min": -180, "max": 180 },
    "activo": { "type": "boolean", "default": true }
  }
}
